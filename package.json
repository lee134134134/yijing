{
  "name": "yijing-agentic-rag",
  "version": "1.0.0",
  "description": "倪海厦知识库 Agentic RAG 系统",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:tui": "TUI=true tsx src/index.ts",
    "server": "START_MODE=server tsx src/api/server.ts",
    "ingest": "tsx src/ingestion/index.ts",
    "migrate": "tsx src/vectorstore/migration.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.1.3",
    "@langchain/core": "^0.3.0",
    "@langchain/openai": "^0.4.0",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.11.1",
    "chromadb": "^3.5.0",
    "dotenv": "^16.4.0",
    "fastify": "^5.9.0",
    "ink": "^5.2.1",
    "ink-text-input": "^6.0.0",
    "langchain": "^0.3.0",
    "minisearch": "^7.2.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "ts-node": "^10.9.0",
    "tsx": "^4.22.4",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.1": true
  }
}
