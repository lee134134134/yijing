    "langchain": "^0.3.0",
    "minisearch": "^7.2.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "ts-node": "^10.9.0",
    "tsx": "^4.22.4",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
