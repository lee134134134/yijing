{
  "name": "yijing-agentic-rag",
  "version": "1.0.0",
  "description": "倪海厦知识库 Agentic RAG 系统",
  "type": "module",
  "engines": {
    "node": ">=26.3.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:tui": "NODE_OPTIONS=--experimental-ffi vite --config vite.tui.config.ts",
    "tui": "node --experimental-ffi --disable-warning=ExperimentalWarning dist-tui/main.js",
    "build:tui": "vite build --config vite.tui.config.ts",
    "server": "START_MODE=server tsx src/api/server.ts",
    "ingest": "tsx src/ingestion/index.ts",
    "migrate": "tsx src/vectorstore/migration.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "typecheck": "tsc --noEmit",
    "typecheck:tui": "vue-tsc -p tui/tsconfig.json --noEmit",
    "typecheck:all": "npm run typecheck && npm run typecheck:tui"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@huggingface/transformers": "^4.2.0",
    "@langchain/core": "^1.2.4",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/openai": "^1.5.5",
    "@langchain/textsplitters": "^1.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.11.1",
    "chromadb": "^3.5.0",
    "deepagents": "^1.12.1",
    "dotenv": "^16.4.0",
    "fastify": "^5.9.0",
    "langchain": "^1.5.4",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "vue": "^3.5.43",
    "vue-termui": "^0.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^4.1.10",
    "ts-node": "^10.9.0",
    "tsx": "^4.22.4",
    "typescript": "^5.6.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "onnxruntime-node": "1.23.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.1": true,
    "protobufjs@7.6.5": true,
    "sharp@0.34.5": true,
    "fsevents@2.3.3": true,
    "onnxruntime-node@1.23.0": true
  }
}
