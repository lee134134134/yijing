{
  "name": "yijing-agentic-rag",
  "version": "1.0.0",
  "description": "倪海厦知识库 Agentic RAG 系统",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:tui": "node --experimental-ffi node_modules/vite/bin/vite.js --config vite.tui.config.ts",
    "tui": "node --experimental-ffi --disable-warning=ExperimentalWarning dist-tui/main.js",
    "build:tui": "vite build --config vite.tui.config.ts",
    "server": "START_MODE=server tsx src/api/server.ts",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "ingest": "tsx src/ingestion/index.ts",
    "migrate": "tsx src/vectorstore/migration.ts",
    "eval": "tsx eval/run.ts",
    "pdf:inventory": "tsx tools/pdf2md/cli.ts --inventory",
    "pdf2md": "tsx tools/pdf2md/cli.ts",
    "pdf:build": "tsx tools/pdf2md/cli.ts --all",
    "pdf:ocr": "tsx tools/pdf2md/cli.ts --ocr-all",
    "ocr:build": "sh tools/ocr/build.sh",
    "ocr:setup": "python3 -m pip install --user -r tools/ocr/requirements.txt",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "biome check src/ web/src tools eval",
    "lint:fix": "biome check --write src/ web/src tools eval",
    "format": "biome format --write src/ web/src tools eval",
    "typecheck": "tsc --noEmit",
    "typecheck:tui": "vue-tsc -p tui/tsconfig.json --noEmit",
    "typecheck:all": "npm run typecheck && npm run typecheck:tui"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^10.1.8",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@huggingface/transformers": "^4.2.0",
    "@langchain/core": "^1.2.4",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/openai": "^1.5.5",
    "@langchain/textsplitters": "^1.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.11.1",
    "chromadb": "^3.5.0",
    "deepagents": "^1.12.1",
    "dotenv": "^16.4.0",
    "fastify": "^5.9.0",
    "langchain": "^1.5.4",
    "pdfjs-dist": "^6.5.438",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "prom-client": "^15.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "vue": "^3.5.43",
    "vue-termui": "^0.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^4.1.10",
    "tailwindcss": "^4.3.4",
    "ts-node": "^10.9.0",
    "tsx": "^4.22.4",
    "typescript": "^5.6.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "onnxruntime-node": "1.23.0"
  }
}
