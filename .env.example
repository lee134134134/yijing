# ==========================================
# 倪海厦知识库 Agentic RAG - 环境配置
# ==========================================

# --- LLM API 配置 ---
# OpenAI 兼容 API 的 Base URL
# OPENAI_BASE_URL=https://api.openai.com/v1

# API Key
# OPENAI_API_KEY=sk-your-key-here

# 对话/分析模型名称
# LLM_MODEL=gpt-4o-mini

# LLM 温度参数（0.0 - 1.0，越低越确定）
# LLM_TEMPERATURE=0.3

# LLM 调用最大重试次数
# LLM_MAX_RETRIES=3

# LLM 重试基础延迟（ms）
# LLM_RETRY_BASE_DELAY=2000

# --- Embedding 配置 ---
# Embedding 模型名称
# EMBEDDING_MODEL=text-embedding-3-small

# Embedding 向量维度
# EMBEDDING_DIMENSION=1536

# --- 向量存储 (ChromaDB) ---
# ChromaDB 服务地址
# CHROMA_DB_URL=http://127.0.0.1:8000

# 集合名称
# CHROMA_COLLECTION_NAME=yijing_knowledge

# --- 知识库配置 ---
# 知识库 Markdown 目录
# KNOWLEDGE_DIR=./memory

# 分块大小（字符数）
# CHUNK_SIZE=800

# 分块重叠（字符数）
# CHUNK_OVERLAP=150

# 每次检索返回的文档数
# RETRIEVAL_TOP_K=5

# --- 检索配置 ---
# 启用查询重写（LLM 将用户问题改写为检索友好形式）
# ENABLE_QUERY_REWRITE=true

# 查询重写时生成的子查询数量
# REWRITE_NUM_QUERIES=3

# 启用 LLM 重排序（额外 LLM 调用，默认关闭）
# ENABLE_RERANKING=false

# --- 上下文窗口 ---
# 最大上下文 Token 数（用于 Token 预算估算和文档裁剪）
# MAX_CONTEXT_TOKENS=8192

# --- 对话配置 ---
# 对话历史最大保留条数
# MAX_HISTORY=200

# --- SQLite ---
# SQLite 数据库路径
# SQLITE_PATH=./data/yijing.db

# --- API Server ---
# API 监听端口
# API_PORT=3001

# API 监听地址
# API_HOST=0.0.0.0

# CORS 允许的来源
# CORS_ORIGIN=http://localhost:5173

# --- 日志 ---
# 日志级别: fatal/error/warn/info/debug/trace
# LOG_LEVEL=info

# 是否写入日志文件
# LOG_FILE=true
