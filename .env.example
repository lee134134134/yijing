# ==========================================
# 倪海厦知识库 Agentic RAG - 环境配置
# ==========================================

# --- LLM API 配置 ---
# OpenAI 兼容 API 的 Base URL
# 示例: https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# API Key
# OPENAI_API_KEY=sk-your-key-here

# --- 模型选择 ---
# 对话/分析模型名称
# LLM_MODEL=gpt-4o-mini

# LLM 温度参数（0.0 - 1.0，越低越确定）
# LLM_TEMPERATURE=0.3

# LLM 调用最大重试次数
# LLM_MAX_RETRIES=3

# LLM 重试基础延迟（ms）
# LLM_RETRY_BASE_DELAY=2000

# --- 知识库配置 ---
# 知识库 Markdown 目录
# KNOWLEDGE_DIR=./memory

# 分块大小（字符数）
# CHUNK_SIZE=800

# 分块重叠（字符数）
# CHUNK_OVERLAP=150

# 每次检索返回的文档数
# RETRIEVAL_TOP_K=5

# --- 检索配置 ---
# 启用混合搜索（n-gram + BM25）
# ENABLE_HYBRID_SEARCH=true

# RRF 融合参数（越大则排序越均匀）
# HYBRID_SEARCH_RRF_K=60

# 启用 LLM 重排序（额外 LLM 调用，默认关闭）
# ENABLE_RERANKING=false

# --- 对话配置 ---
# 对话历史最大保留条数
# MAX_HISTORY=200
