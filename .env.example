# ==========================================
# 倪海厦知识库 Agentic RAG - 环境配置
# ==========================================

# --- LLM API 配置 ---
# OpenAI 兼容 API 的 Base URL
# OPENAI_BASE_URL=https://api.openai.com/v1

# API Key
# OPENAI_API_KEY=sk-your-key-here

# 对话/分析模型名称
# LLM_MODEL=gpt-4o-mini

# 深度分析(/deep)专用模型
# DEEP_MODEL=deepseek-v4-flash-free

# 深度分析 agent 最大迭代轮数(防止检索死循环)
# DEEP_AGENT_MAX_ITERATIONS=25

# 是否启用 DeepAgent 任务规划中间件(todoListMiddleware)
# ENABLE_TODO_PLANNING=true

# LLM 温度参数（0.0 - 1.0，越低越确定）
# LLM_TEMPERATURE=0.3

# LLM 调用最大重试次数
# LLM_MAX_RETRIES=3

# LLM 重试基础延迟（ms）
# LLM_RETRY_BASE_DELAY=2000

# --- 第三方大模型接入 / Provider 路由（可选） ---
# 统一 provider 预设: openai / openrouter / deepseek / moonshot / qwen / zhipu /
# siliconflow / groq / ollama / lmstudio / opencode / custom
# 不设置时按 OPENAI_BASE_URL 自动识别,旧配置(OPENAI_BASE_URL + OPENAI_API_KEY + LLM_MODEL)零迁移。
# LLM_PROVIDER=openrouter

# 全局 base URL 覆盖（优先级高于 provider 预设;旧 OPENAI_BASE_URL 仍可用）
# LLM_BASE_URL=

# 全局 API Key（优先级低于 provider 专属 key）
# LLM_API_KEY=

# 各 provider 专属 key（按需设置,推荐；不要把所有厂商 key 都塞进 OPENAI_API_KEY）
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=
# DASHSCOPE_API_KEY=
# ZHIPU_API_KEY=
# SILICONFLOW_API_KEY=
# GROQ_API_KEY=
# OPENCODE_API_KEY=

# 任意 provider 的 key 映射（JSON;自定义网关/多 key 场景）
# LLM_PROVIDER_KEYS={"my-gateway":"sk-..."}

# 额外请求头（JSON;如 OpenRouter 的 HTTP-Referer / X-Title）
# LLM_EXTRA_HEADERS={"HTTP-Referer":"https://example.com","X-Title":"Yijing RAG"}

# 角色级覆盖: main / deep / classify / rewrite 可分别路由到不同 provider
# 同一套变量把 MAIN 换成 DEEP / CLASSIFY / REWRITE 即可
# LLM_DEEP_PROVIDER=deepseek
# LLM_DEEP_MODEL=deepseek-chat
# LLM_DEEP_API_KEY=
# LLM_DEEP_BASE_URL=
# LLM_DEEP_TEMPERATURE=0.1
# LLM_DEEP_MAX_TOKENS=
# LLM_DEEP_EXTRA_HEADERS={}
# LLM_DEEP_MODEL_KWARGS={}

# deep 角色 JSON 输出策略: auto(按 provider 能力) / on(强制) / off(关闭)
# LLM_DEEP_JSON_MODE=auto

# 单次 LLM 请求超时（ms）
# LLM_TIMEOUT_MS=120000

# 外挂 provider 注册文件（JSON;新增网关无需改代码,格式见 README）
# LLM_PROVIDERS_FILE=./config/llm-providers.json

# --- Embedding 配置 ---

# Embedding 提供方:local(本地模型,离线可用,默认) | api(OpenAI 兼容 API)
# 注意:切换提供方会改变向量维度,必须重新执行 npm run ingest
# EMBEDDING_PROVIDER=local

# 独立的 Embedding API 地址(默认复用 OPENAI_BASE_URL,仅 provider=api 时生效)
# EMBEDDING_BASE_URL=

# 独立的 Embedding API Key(默认复用 OPENAI_API_KEY,仅 provider=api 时生效)
# EMBEDDING_API_KEY=

# Embedding 模型:
# - provider=local 时为 HF 模型名(默认 Xenova/all-MiniLM-L6-v2,384 维)
# - provider=api 时为 OpenAI 兼容模型名(默认 text-embedding-3-small,1536 维)
# 注:all-MiniLM-L6-v2 为英文模型,中文语料建议改用 Xenova/bge-small-zh-v1.5
# (512 维,中文语义区分度显著更好);换模型必须重新 ingest
# EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Embedding 向量维度(仅作信息展示,实际维度由模型/API 决定)
# EMBEDDING_DIMENSION=384

# 本地模型缓存目录(Docker 构建期预下载到 /app/model-cache,运行时离线可用)
# EMBEDDING_CACHE_DIR=./data/models

# HuggingFace 镜像源(huggingface.co 访问受阻时切换)
# HF_MIRROR=https://hf-mirror.com/

# --- 向量存储 (ChromaDB) ---
# ChromaDB 服务地址
# CHROMA_DB_URL=http://127.0.0.1:8000

# 集合名称
# CHROMA_COLLECTION_NAME=yijing_knowledge

# --- 知识库配置 ---
# 知识库 Markdown 目录
# KNOWLEDGE_DIR=./memory

# 分块大小（字符数）
# CHUNK_SIZE=800

# 分块重叠（字符数）
# CHUNK_OVERLAP=150

# 每次检索返回的文档数
# RETRIEVAL_TOP_K=5

# --- 检索配置 ---
# 启用查询重写（LLM 将用户问题改写为检索友好形式）
# ENABLE_QUERY_REWRITE=true

# 查询重写时生成的子查询数量
# REWRITE_NUM_QUERIES=3

# 启用 LLM 重排序（额外 LLM 调用，默认关闭）
# ENABLE_RERANKING=false

# --- 上下文窗口 ---
# 最大上下文 Token 数（用于 Token 预算估算和文档裁剪）
# MAX_CONTEXT_TOKENS=8192

# --- 对话配置 ---
# 对话历史最大保留条数
# MAX_HISTORY=200

# --- SQLite ---
# SQLite 数据库路径
# SQLITE_PATH=./data/yijing.db

# --- API Server ---
# API 监听端口
# API_PORT=3001

# API 监听地址
# API_HOST=0.0.0.0

# CORS 允许的来源
# CORS_ORIGIN=http://localhost:5173

# 最大请求体大小（字节）
# MAX_BODY_SIZE=10485760

# 请求ID头名称
# REQUEST_ID_HEADER=x-request-id

# --- 安全 ---

# 未认证客户端每分钟最大请求数
# RATE_LIMIT_MAX=100

# 已认证客户端每分钟最大请求数
# RATE_LIMIT_AUTH_MAX=1000

# API 密钥列表（逗号分隔；设置后启用认证，X-API-Key 头传入）
# 未设置时回退 OPENAI_API_KEY；两者都为空则禁用认证（仅限本地开发）
# API_KEYS=key1,key2

# --- CLI ---

# TUI 模式开关（TUI=true 且无参数时启动终端界面）
# TUI=false

# --- 日志 ---
# 日志级别: fatal/error/warn/info/debug/trace
# LOG_LEVEL=info

# 是否写入日志文件
# LOG_FILE=true
